# Copy to .env and fill in. .env is gitignored - it carries a password.
#
#   psql -U postgres -c "CREATE ROLE rigs LOGIN PASSWORD 'your-dev-password';"
#   psql -U postgres -c "CREATE DATABASE rigs_dev OWNER rigs;"
#   psql -U postgres -c "CREATE DATABASE rigs_test OWNER rigs;"

DATABASE_URL=postgresql+asyncpg://rigs:your-dev-password@127.0.0.1:5432/rigs_dev
TEST_DATABASE_URL=postgresql+asyncpg://rigs:your-dev-password@127.0.0.1:5432/rigs_test

# Video. With no endpoint set, a directory is used instead - real enough
# to exercise the whole path and honest about not being S3.
#
#   minio server .minio-data --address 127.0.0.1:9000
#
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_BUCKET=rigs-video
# STORAGE_ACCESS_KEY=rigsdev
# STORAGE_SECRET_KEY=your-dev-secret

# How many days archived video is kept. Decided: 90, which is also the
# default in config.py - this line is here to make it visible, not to
# supply it.
#
# At the plan's own sizing - ~2.7 TB a day across twelve rigs - ninety
# days is a steady state of roughly 245 TB. It climbs for ninety days and
# is flat after that, and that is the number the cold tier needs.
#
# Deleting is the only irreversible thing this service does. It only ever
# touches video that reached the cold tier and was released, and it never
# touches the episode - the score, the attribution and the four seconds
# columns cost nothing to keep and are the point of the system.
#
# Set 0 to keep everything for ever.
VIDEO_KEEP_DAYS=90

# How long the service waits for a take the rig asked to upload and never
# delivered. Decided: 7 days - a weekend plus a rig away for repair.
#
# Nothing is deleted; the bytes were never here, they are on the rig. It
# only stops a take nobody will ever send from sitting in the backlog
# that is supposed to say whether the spool is healthy. If the take does
# turn up later, confirm() puts the row straight back, so a rig returning
# from a workshop uploads its backlog and the rows heal themselves.
#
# Set 0 to wait for ever.
VIDEO_PENDING_AFTER_DAYS=7

# ---------------------------------------------------------------- auth
#
# A token per rig, placed on the machine by Ansible beside /etc/rig/id.
# The machine authenticates; the operator never does, which is what lets
# the rig keep being a screen with three pedals and no login.
#
# Unset means every caller may file events for any rig. That is right for
# a laptop demo and wrong for a floor, so it is not silent: the service
# logs it at startup and /api/health reports {"rigAuth": "off"} - which is
# a thing a deploy check should fail on.
#
# Generate one per rig and never reuse them across rigs. A shared token
# would let one compromised machine attribute work for the whole floor:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# RIG_TOKENS={"RIG-01": "...", "RIG-02": "...", "RIG-03": "..."}

# The desk's write path. The plan deliberately does not decide this one -
# the desk is expected to sit behind the platform team's gateway, which
# already handles who is allowed in. Set it if nothing is in front of
# this, or a schedule push is open to anyone who can reach the port.
#
# DESK_TOKEN=

# ------------------------------------------------------------- limits
#
# The largest single video this service will take through itself. Only
# the gateway-upload model reads a body into memory; a presigned PUT
# never touches this process.
#
# MAX_VIDEO_BYTES=2147483648

# The pool. The default of 5 is sized for one process serving requests;
# this service also runs three workers that each hold a session.
#
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
