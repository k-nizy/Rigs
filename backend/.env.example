# Copy to .env and fill in. .env is gitignored - it carries a password.
#
#   psql -U postgres -c "CREATE ROLE rigs LOGIN PASSWORD 'your-dev-password';"
#   psql -U postgres -c "CREATE DATABASE rigs_dev OWNER rigs;"
#   psql -U postgres -c "CREATE DATABASE rigs_test OWNER rigs;"

DATABASE_URL=postgresql+asyncpg://rigs:your-dev-password@127.0.0.1:5432/rigs_dev
TEST_DATABASE_URL=postgresql+asyncpg://rigs:your-dev-password@127.0.0.1:5432/rigs_test

# Video. With no endpoint set, a directory is used instead - real enough
# to exercise the whole path and honest about not being S3.
#
#   minio server .minio-data --address 127.0.0.1:9000
#
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_BUCKET=rigs-video
# STORAGE_ACCESS_KEY=rigsdev
# STORAGE_SECRET_KEY=your-dev-secret

# How many days archived video is kept. Decided: 90, which is also the
# default in config.py - this line is here to make it visible, not to
# supply it.
#
# At the plan's own sizing - ~2.7 TB a day across twelve rigs - ninety
# days is a steady state of roughly 245 TB. It climbs for ninety days and
# is flat after that, and that is the number the cold tier needs.
#
# Deleting is the only irreversible thing this service does. It only ever
# touches video that reached the cold tier and was released, and it never
# touches the episode - the score, the attribution and the four seconds
# columns cost nothing to keep and are the point of the system.
#
# Set 0 to keep everything for ever.
VIDEO_KEEP_DAYS=90

# How long the service waits for a take the rig asked to upload and never
# delivered. Decided: 7 days - a weekend plus a rig away for repair.
#
# Nothing is deleted; the bytes were never here, they are on the rig. It
# only stops a take nobody will ever send from sitting in the backlog
# that is supposed to say whether the spool is healthy. If the take does
# turn up later, confirm() puts the row straight back, so a rig returning
# from a workshop uploads its backlog and the rows heal themselves.
#
# Set 0 to wait for ever.
VIDEO_PENDING_AFTER_DAYS=7

# ------------------------------------------------------------ identity
#
# Which address each rig calls from. The service uses it to tell the
# twelve machines apart *before* any of them has said who it is, which is
# the question the token below cannot answer.
#
# It has to name the same rigs as RIG_TOKENS - a rig with one and not the
# other either can never be identified or is refused on every call, and
# both fail somewhere else entirely. Preflight compares them.
#
# Empty means rigs are not told apart, which is right for a laptop and
# wrong for a floor. A rig that reaches a service which identifies its
# rigs, and was not identified by it, refuses to work rather than falling
# back to a default and filing takes under another rig's name.
#
# RIG_ADDRESSES={"RIG-01":"10.0.0.11","RIG-02":"10.0.0.12"}

# ---------------------------------------------------------------- auth
#
# A token per rig, handed to the page by the service in rig-config.js,
# answered per caller from RIG_ADDRESSES above.
# The machine authenticates; the operator never does, which is what lets
# the rig keep being a screen with three pedals and no login.
#
# Unset means every caller may file events for any rig. That is right for
# a laptop demo and wrong for a floor, so it is not silent: the service
# logs it at startup and /api/health reports {"rigAuth": "off"} - which is
# a thing a deploy check should fail on.
#
# Generate one per rig and never reuse them across rigs. A shared token
# would let one compromised machine attribute work for the whole floor:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# RIG_TOKENS={"RIG-01": "...", "RIG-02": "...", "RIG-03": "..."}

# The desk's write path. The plan deliberately does not decide this one -
# the desk is expected to sit behind the platform team's gateway, which
# already handles who is allowed in. Set it if nothing is in front of
# this, or a schedule push is open to anyone who can reach the port.
#
# DESK_TOKEN=

# Whether READING the floor needs that token too. Off by default, and
# separate from the line above on purpose: /api/floor/state is what a wall
# display shows and what the desk polls, so making it need a secret is a
# product decision rather than a security default. Writes are gated by
# DESK_TOKEN on its own either way. With no DESK_TOKEN set this does
# nothing, because there would be nothing to check against.
#
# PROTECT_FLOOR_READS=false

# Requests per minute per rig, on the rig-facing routes. 0 is off, and off
# is the default because the platform team's gateway may already own this.
#
# A ceiling, not a target: the floor's sustained rate is about 0.01
# requests per second per rig. Size it for a rig coming back from an
# outage and emptying its outbox in one go - that is correct behaviour and
# a limit sized for the average would punish it. 120 is generous.
#
# Being refused is safe. The rig keeps the events, backs off, and ingest
# dedupes the retry, so a limited rig uploads late rather than not at all.
# In-process, so N instances allow N times this. Exactly-right limiting
# across instances is a gateway's job.
#
# RIG_RATE_LIMIT_PER_MIN=0

# ------------------------------------------------------------- limits
#
# The largest single video this service will take through itself. Only
# the gateway-upload model reads a body into memory; a presigned PUT
# never touches this process.
#
# MAX_VIDEO_BYTES=2147483648

# The pool. The default of 5 is sized for one process serving requests;
# this service also runs three workers that each hold a session.
#
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10

# ------------------------------------------------------------- people
#
# Signing in to the desk. Unrelated to RIG_TOKENS above: that
# authenticates a machine, this authenticates a person, and the rig has
# no login and is not getting one.
#
# There is no sign-up page. Accounts are made with:
#
#   python -m tools.mint_account manager  --email you@verlet.co --name "Your Name"
#   python -m tools.mint_account operator --email them@verlet.co --name "..." --operator-id op-a2
#   python -m tools.mint_account list
#
# With no accounts at all the service reports {"personAuth": "off"} and
# behaves as it did before there was such a thing - the same
# off-until-configured rule as rig auth.

# How long somebody stays signed in. A shift is eight hours; twelve
# covers one plus the handover either side, so signing in at the top of
# a shift cannot throw somebody out in the middle of it.
# SESSION_LIFETIME_HOURS=12

# Whether the session cookie is HTTPS-only. True by default, and
# deliberately the opposite way round from the switches above: those are
# off until configured so a laptop demo needs no setup, but this one
# protects a credential and a default of "unsafe" is a deployment that
# ships unsafe.
#
# Set it false for local development over plain http - and only for that.
# /api/health answers {"sessionCookie": "INSECURE"} when it is off.
# SESSION_COOKIE_SECURE=true

# Sign-in attempts per minute per calling address. On by default, unlike
# RIG_RATE_LIMIT_PER_MIN, and that is not an inconsistency: the rig limit
# is off because the gateway may already own it, whereas an unthrottled
# password endpoint is a brute-force target whoever is in front of it.
# 0 turns it off.
# LOGIN_RATE_LIMIT_PER_MIN=10
