# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Nothing here is built from dependencies, but keep these out if they appear
node_modules/
__pycache__/

# server state - what this floor was pushed, not source. pushes.jsonl is
# the record and state.json the cache derived from its last line.
apps/server/state.json
apps/server/state.json.tmp
apps/server/pushes.jsonl

# Backend secrets and local state. The database URL carries a password;
# it must never reach the repo.
backend/.env
backend/.env.*
!backend/.env.example
__pycache__/
*.pyc
.venv/
backend/.pytest_cache/
backend/.venv/
backend/.import_linter_cache/
backend/*.egg-info/
backend/.storage/
backend/.minio-data/

# local dev server logs
backend/.gateway.log
backend/.gateway.err

# transient uvicorn logs from a production-entrypoint smoke test
backend/.prod.log
backend/.prod.err
# minted per-rig secrets, if anyone runs mint_tokens --out here
rig-secrets/

# The kiosk shell's build output. Rust puts it here by default; the
# committed project is the source, not the several gigabytes of it.
apps/rig/desktop/target/

# Tauri regenerates these on every build and names them after whichever
# machine ran it - linux-schema.json here, macos-schema.json elsewhere -
# so committing them is churn that says nothing. They are editor
# autocomplete for capability files, not inputs to the build.
# Cargo.lock is committed, deliberately: this is a binary, and the whole
# point of pinning is that the rig runs what was tested.
apps/rig/desktop/gen/schemas/
