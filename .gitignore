# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Nothing here is built from dependencies, but keep these out if they appear
node_modules/
__pycache__/

# server state - regenerated on every push, not source
apps/server/state.json

# Backend secrets and local state. The database URL carries a password;
# it must never reach the repo.
backend/.env
backend/.env.*
!backend/.env.example
__pycache__/
*.pyc
.venv/
backend/.pytest_cache/
backend/.venv/
backend/.import_linter_cache/
backend/*.egg-info/
backend/.storage/
backend/.minio-data/

# local dev server logs
backend/.gateway.log
backend/.gateway.err

# transient uvicorn logs from a production-entrypoint smoke test
backend/.prod.log
backend/.prod.err
# minted per-rig secrets, if anyone runs mint_tokens --out here
rig-secrets/
