[Unit]
Description=Rigs API
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=rigs.target

[Service]
Type=exec
User=rigs
Group=rigs
WorkingDirectory=/srv/rigs/backend
EnvironmentFile=/etc/rigs/rigs.env

# Refuse to start against a database that is not migrated, rather than
# starting and failing at the first request that touches a missing column.
ExecStartPre=/srv/rigs/backend/.venv/bin/python -m tools.preflight

ExecStart=/srv/rigs/backend/.venv/bin/python -m uvicorn services.rigs.app:app \
    --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips='127.0.0.1'

Restart=always
RestartSec=3

# The service reads and writes the spool and nothing else on this disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/rigs/spool

[Install]
WantedBy=rigs.target
